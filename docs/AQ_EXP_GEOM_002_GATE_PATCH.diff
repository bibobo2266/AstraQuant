--- a/scripts/astraquant_aq_exp_data_001.py
+++ b/scripts/astraquant_aq_exp_data_001.py
@@ -75,6 +75,38 @@ def read_parquet_columns(path: Path, wanted: list[str]) -> pd.DataFrame:
     return out
 
 
+def _passes_ohlc_geometry(x: pd.DataFrame) -> pd.Series:
+    """OHLC 幾何閘門：True 表示該列的 bar 幾何合格。
+
+    與上游 tradability.valid_ohlc **互相獨立**，本函式不讀該欄。
+    這條閘門的全部意義就是把幾何防線從單點變成兩點；若此處引用
+    valid_ohlc，等於沒做。
+
+    四條斷言：
+      high >= low
+      high >= max(open, close)
+      low  <= min(open, close)
+      open/high/low/close 皆為有限正值
+
+    fail-closed：任一條不成立、任一欄缺失或非數值（NaN/null/非數字字串），
+    一律判為不合格，不以推估或鄰列填補。
+    """
+    def num(col: str) -> pd.Series:
+        if col not in x.columns:
+            return pd.Series(np.nan, index=x.index, dtype="float64")
+        return pd.to_numeric(x[col], errors="coerce")
+
+    o, h, l, c = num("open"), num("max"), num("min"), num("close")
+    finite_positive = (
+        np.isfinite(o) & np.isfinite(h) & np.isfinite(l) & np.isfinite(c)
+        & o.gt(0) & h.gt(0) & l.gt(0) & c.gt(0)
+    )
+    bad = (
+        h.lt(l).where(finite_positive, True).fillna(True)
+        | h.lt(np.maximum(o, c)).where(finite_positive, True).fillna(True)
+        | l.gt(np.minimum(o, c)).where(finite_positive, True).fillna(True)
+        | ~finite_positive.fillna(False)
+    )
+    return ~bad.astype(bool)
+
+
